# Gemini LLM Provider (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Observability (Optional - system functions normally if disabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=octs-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Server & Security Configuration
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000

# Phase 4 Evaluation Engine (Optional)
EVALUATION_ENABLED=true
EVALUATION_MODE=deterministic
EVALUATION_QUALITY_WEIGHT=0.70
EVALUATION_RELIABILITY_WEIGHT=0.30
EVALUATION_JUDGE_ENABLED=false
EVALUATION_TIMEOUT=10.0
EVALUATION_MAX_RETRIES=1

# Phase 5 Autonomous Refinement & Specialist Collaboration (Optional)
REFINEMENT_ENABLED=true
REFINEMENT_THRESHOLD=70.0
REFINEMENT_MAX_ATTEMPTS=2
PEER_REVIEW_ENABLED=true
PEER_REVIEW_TIMEOUT=10.0
